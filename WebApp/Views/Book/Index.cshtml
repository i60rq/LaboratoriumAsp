@model List<Book>
<h2>Lista książek</h2>
<a class="btn btn-primary" asp-controller="Book" asp-action="Create">Dodaj książkę</a>
<table class="table">
    <thead>
    <th>
        Tytuł
    </th>
    <th>
        Rok
    </th>
    <th>
        Autor
    </th>
    <th>
        Cena
    </th>
    </thead>
    <tbody>
        @foreach (var book in @Model)
        {
            <partial model="@book" name="_BookRow"/>
        }
    </tbody>
</table>